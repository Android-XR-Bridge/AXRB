{
  "name": "axrb-emulatorless-launcher",
  "version": "2.0.0",
  "private": true,
  "description": "Quest library and native Windows AXRB launcher",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "node start.cjs",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node start.cjs --smoke-test",
    "build": "npm run build:quest && vite build",
    "build:quest": "powershell -NoProfile -ExecutionPolicy Bypass -File device/build.ps1",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build/installer.ps1",
    "dist:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build/build-launcher.ps1 -Portable"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.4.1",
    "electron-builder": "^26.15.3",
    "semver": "7.8.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.22",
    "@assistant-ui/react-markdown": "0.14.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "6.8.9",
    "jose": "6.2.12",
    "lucide-react": "^1.46.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.7.0",
    "yauzl": "^3.4.0",
    "yazl": "3.3.1"
  },
  "productName": "AXRB-Emulatorless",
  "author": "AXRB contributors",
  "build": {
    "appId": "org.axrb.emulatorless",
    "productName": "AXRB-Emulatorless",
    "directories": {
      "output": "../out/releases"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "core/**",
      "dist/**",
      "assets/axrb.ico",
      "assets/quest-catalog.jar",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "../out/distribution/resources",
        "to": "."
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AXRB-Emulatorless-${version}.${ext}",
      "icon": "assets/axrb.ico"
    },
    "portable": {
      "unpackDirName": false
    },
    "nsis": {
      "artifactName": "AXRB-Emulatorless-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "AXRB-Emulatorless",
      "runAfterFinish": true
    },
    "beforePack": "./prepare-builder.cjs",
    "afterPack": "./verify-packaged-release.cjs",
    "publish": null
  }
}
