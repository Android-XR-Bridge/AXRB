{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/host"
    },
    {
      "name": "protocol",
      "inherits": "windows",
      "binaryDir": "${sourceDir}/out/protocol",
      "cacheVariables": {
        "AXRB_BUILD_ANDROID_RUNTIME": "OFF",
        "AXRB_BUILD_HOST_BRIDGE": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "Release"
    },
    {
      "name": "protocol",
      "configurePreset": "protocol",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "protocol",
      "configurePreset": "protocol",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
