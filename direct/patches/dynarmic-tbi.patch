+// Top Byte Ignore: Linux runs arm64 user space with TBI enabled for data
+// accesses, and Android's allocator hands out pointers tagged in bits 56-63.
+IR::U64 IREmitter::UntagAddress(const IR::U64& vaddr) {
+    if (vaddr.IsImmediate()) {
+        return Imm64(vaddr.GetImmediateAsU64() & 0x00FF'FFFF'FFFF'FFFFull);
+    }
+    return And(vaddr, Imm64(0x00FF'FFFF'FFFF'FFFFull));
+}
