diff --git a/src/dynarmic/backend/x64/emit_x64.h b/src/dynarmic/backend/x64/emit_x64.h
index 5a46f04e..d043c10a 100644
--- a/src/dynarmic/backend/x64/emit_x64.h
+++ b/src/dynarmic/backend/x64/emit_x64.h
@@ -78,6 +78,16 @@ public:
         size_t size;         // Length in bytes of emitted code
     };
 
+    /// The block whose emitted code contains `host` (linear search; profilers).
+    std::optional<IR::LocationDescriptor> LocationForHostCode(CodePtr host) const {
+        for (const auto& [location, block] : block_descriptors) {
+            const auto* begin = static_cast<const std::uint8_t*>(block.entrypoint);
+            const auto* at = static_cast<const std::uint8_t*>(host);
+            if (at >= begin && at < begin + block.size) return location;
+        }
+        return std::nullopt;
+    }
+
     explicit EmitX64(BlockOfCode& code);
     virtual ~EmitX64();
 
