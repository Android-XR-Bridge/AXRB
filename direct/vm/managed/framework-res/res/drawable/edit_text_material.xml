<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetLeft="@dimen/control_inset_material" android:insetRight="@dimen/control_inset_material"
    android:insetTop="10dp" android:insetBottom="7dp">
  <layer-list>
    <item>
      <shape android:shape="rectangle">
        <solid android:color="@color/transparent" />
        <padding android:left="0dp" android:top="4dp" android:right="0dp" android:bottom="8dp" />
      </shape>
    </item>
    <item android:gravity="bottom|fill_horizontal" android:height="2dp">
      <selector>
        <item android:state_focused="true">
          <shape android:shape="rectangle"><solid android:color="@color/edit_text_underline_material" /></shape>
        </item>
        <item>
          <inset android:insetTop="1dp">
            <shape android:shape="rectangle"><solid android:color="@color/edit_text_underline_material" /></shape>
          </inset>
        </item>
      </selector>
    </item>
  </layer-list>
</inset>