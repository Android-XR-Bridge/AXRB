<?xml version="1.0" encoding="utf-8"?>
<!--
  Themes of the runtime. Every public theme family (legacy Theme, Holo,
  Material, DeviceDefault) resolves to the same Material-style widget set; the
  families differ in palette and window features only. Parents are explicit.
-->
<resources>
  <!-- ===== Base: dark palette, legacy title bar ===== -->
  <style name="Theme" parent="">
    <item name="isLightTheme">false</item>
    <item name="colorForeground">@color/foreground_material_dark</item>
