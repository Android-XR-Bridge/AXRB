  <!-- Window-feature mixins, repeated per family below. -->
  <style name="Theme.NoTitleBar" parent="Theme">
    <item name="windowNoTitle">true</item>
  </style>
  <style name="Theme.NoTitleBar.Fullscreen" parent="Theme.NoTitleBar">
    <item name="windowFullscreen">true</item>
  </style>
  <style name="Theme.NoTitleBar.OverlayActionModes" parent="Theme.NoTitleBar" />
  <style name="Theme.WithActionBar" parent="Theme">
    <item name="windowActionBar">true</item>
    <item name="windowNoTitle">true</item>
  </style>
  <style name="Theme.Black" parent="Theme">
    <item name="colorBackground">@color/black</item>
  </style>
  <style name="Theme.Black.NoTitleBar" parent="Theme.Black">
    <item name="windowNoTitle">true</item>
  </style>
  <style name="Theme.Black.NoTitleBar.Fullscreen" parent="Theme.Black.NoTitleBar">
    <item name="windowFullscreen">true</item>
  </style>
  <style name="Theme.Light.NoTitleBar" parent="Theme.Light">
    <item name="windowNoTitle">true</item>
  </style>
  <style name="Theme.Light.NoTitleBar.Fullscreen" parent="Theme.Light.NoTitleBar">
    <item name="windowFullscreen">true</item>
  </style>
  <style name="Theme.Translucent" parent="Theme">
    <item name="windowBackground">@color/transparent</item>
    <item name="windowIsTranslucent">true</item>
  </style>
  <style name="Theme.Translucent.NoTitleBar" parent="Theme.Translucent">
    <item name="windowNoTitle">true</item>
  </style>
  <style name="Theme.Translucent.NoTitleBar.Fullscreen" parent="Theme.Translucent.NoTitleBar">
    <item name="windowFullscreen">true</item>
  </style>
  <style name="Theme.NoDisplay" parent="Theme">
    <item name="windowBackground">@null</item>
    <item name="windowIsTranslucent">true</item>
    <item name="windowNoTitle">true</item>
  </style>
  <style name="Theme.Dialog" parent="Theme">
    <item name="windowIsFloating">true</item>
    <item name="windowBackground">@drawable/dialog_background_material</item>
    <item name="windowCloseOnTouchOutside">true</item>
  </style>
  <style name="Theme.Panel" parent="Theme">
    <item name="windowBackground">@color/transparent</item>
    <item name="windowIsFloating">true</item>
    <item name="windowNoTitle">true</item>
  </style>
  <style name="Theme.Light.Panel" parent="Theme.Light">
    <item name="windowBackground">@color/transparent</item>
    <item name="windowIsFloating">true</item>
    <item name="windowNoTitle">true</item>
  </style>
  <style name="Theme.InputMethod" parent="Theme.Panel" />
  <style name="Theme.Wallpaper" parent="Theme">
    <item name="windowBackground">@color/transparent</item>
  </style>
  <style name="Theme.Wallpaper.NoTitleBar" parent="Theme.Wallpaper">
    <item name="windowNoTitle">true</item>
  </style>
  <style name="Theme.Wallpaper.NoTitleBar.Fullscreen" parent="Theme.Wallpaper.NoTitleBar">
    <item name="windowFullscreen">true</item>
  </style>
  <style name="Theme.WallpaperSettings" parent="Theme.Dialog" />
  <style name="Theme.Light.WallpaperSettings" parent="Theme.Material.Light.Dialog" />

