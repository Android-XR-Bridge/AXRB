+// berberis.interp_stats=1: measurement only. Counts interpreter entries by entry pc and the
+// instructions each runs; every 2 s logs the rates and hottest entries (tag berberis_interp).
+namespace interp_stats {
+
+constexpr size_t kTableSize = 1 << 16;
+constexpr int kMaxProbes = 32;
+struct Slot {
+  std::atomic<uint64_t> pc;
+  std::atomic<uint64_t> calls;
+  std::atomic<uint64_t> insns;
+};
+Slot g_slots[kTableSize];
+std::atomic<uint64_t> g_calls;
+std::atomic<uint64_t> g_insns;
+uint64_t g_last_calls;
+uint64_t g_last_insns;
+std::atomic<int64_t> g_last_dump_ns;
+std::mutex g_dump_mutex;
+
+bool Enabled() {
+  static const bool value = ConfigFlag("BERBERIS_INTERP_STATS", "berberis.interp_stats");
+  return value;
+}
+
+int64_t NowNs() {
+  timespec ts;
+  clock_gettime(CLOCK_MONOTONIC_COARSE, &ts);
+  return ts.tv_sec * 1'000'000'000LL + ts.tv_nsec;
+}
+
+void Dump(int64_t now, int64_t last) {
+  double seconds = (now - last) / 1e9;
+  uint64_t calls = g_calls.load(std::memory_order_relaxed);
+  uint64_t insns = g_insns.load(std::memory_order_relaxed);
+  __android_log_print(ANDROID_LOG_INFO, "berberis_interp",
+                      "over %.2fs: entries/s=%.0f insns/s=%.0f insns/entry=%.1f", seconds,
+                      (calls - g_last_calls) / seconds, (insns - g_last_insns) / seconds,
+                      calls == g_last_calls ? 0.0
+                                            : double(insns - g_last_insns) / (calls - g_last_calls));
+  g_last_calls = calls;
+  g_last_insns = insns;
+  struct Hot {
+    uint64_t pc, calls, insns;
+  };
+  static Hot hot[kTableSize];
+  size_t used = 0;
+  for (Slot& slot : g_slots) {
+    uint64_t slot_insns = slot.insns.exchange(0, std::memory_order_relaxed);
+    uint64_t slot_calls = slot.calls.exchange(0, std::memory_order_relaxed);
+    if (slot_insns) {
+      hot[used++] = {slot.pc.load(std::memory_order_relaxed), slot_calls, slot_insns};
+    }
+  }
+  size_t shown = std::min<size_t>(used, 40);
+  std::partial_sort(hot, hot + shown, hot + used,
+                    [](const Hot& a, const Hot& b) { return a.insns > b.insns; });
+  for (size_t i = 0; i < shown; i++) {
+    auto record = MapsSnapshot::GetInstance()->GetMappedObjectRecordOrUpdateAndRetry(hot[i].pc);
+    const char* path = record ? record->pathname.c_str() : "?";
+    const char* base = strrchr(path, '/');
+    uint32_t word = *ToHostAddr<const uint32_t>(hot[i].pc);
+    __android_log_print(ANDROID_LOG_INFO, "berberis_interp",
+                        "hot insns/s=%.0f entries/s=%.0f %s+0x%llx insn=%08x", hot[i].insns / seconds,
+                        hot[i].calls / seconds, base ? base + 1 : path,
+                        static_cast<unsigned long long>(record ? hot[i].pc - record->start : hot[i].pc),
+                        word);
+  }
+}
+
+void Record(GuestAddr pc, int insns) {
+  size_t index = (pc * 0x9E3779B97F4A7C15ULL) >> 48;
+  for (int probe = 0; probe < kMaxProbes; probe++) {
+    Slot& slot = g_slots[(index + probe) & (kTableSize - 1)];
+    uint64_t current = slot.pc.load(std::memory_order_relaxed);
+    if (current == 0 && slot.pc.compare_exchange_strong(current, pc, std::memory_order_relaxed)) {
+      current = pc;
+    }
+    if (current == pc) {
+      slot.calls.fetch_add(1, std::memory_order_relaxed);
+      slot.insns.fetch_add(insns, std::memory_order_relaxed);
+      break;
+    }
+  }
+  g_insns.fetch_add(insns, std::memory_order_relaxed);
+  if ((g_calls.fetch_add(1, std::memory_order_relaxed) & 0x3ff) == 0) {
+    int64_t now = NowNs();
+    int64_t last = g_last_dump_ns.load(std::memory_order_relaxed);
+    if (last == 0) {
+      g_last_dump_ns.store(now, std::memory_order_relaxed);
+    } else if (now - last >= 2'000'000'000LL && g_dump_mutex.try_lock()) {
+      if (g_last_dump_ns.compare_exchange_strong(last, now, std::memory_order_relaxed)) {
+        Dump(now, last);
+      }
+      g_dump_mutex.unlock();
+    }
+  }
+}
