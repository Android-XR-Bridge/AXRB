diff --git a/android_api/linker/__libc_init_main_thread.cpp b/android_api/linker/__libc_init_main_thread.cpp
index fea38b2..50e9212 100644
--- a/android_api/linker/__libc_init_main_thread.cpp
+++ b/android_api/linker/__libc_init_main_thread.cpp
@@ -31,6 +31,9 @@ extern "C" void __native_bridge_config_static_tls(const NativeBridgeStaticTlsCon
 
 // Get the current thread's host pthread_internal_t.
 extern "C" pthread_t __native_bridge_get_host_pthread();
+#if defined(__aarch64__)
+extern "C" void* __native_bridge_get_host_bionic_tls();
+#endif
 
 // The host has already initialized the thread and created its
 // pthread_internal_t object. The guest needs to initialize its globals and the
@@ -50,7 +53,12 @@ extern "C" void __libc_init_main_thread_early(const KernelArgumentBlock& args,
 
 extern "C" void __libc_init_main_thread_late() {
   // Reuse the host's bionic_tls structure.
+#if defined(__aarch64__)
+  // Host pthread_internal_t fields can move between Android releases.
+  __get_tls()[TLS_SLOT_BIONIC_TLS] = __native_bridge_get_host_bionic_tls();
+#else
   __get_tls()[TLS_SLOT_BIONIC_TLS] = __get_thread()->bionic_tls;
+#endif
 
   // There's currently no way for the guest to query the host's stack guard
   // cookie, so just generate a new one.
