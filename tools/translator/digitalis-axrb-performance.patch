+// region digitalis
+namespace {
+
+struct PatchableRegion {
+  uintptr_t begin;
+  uintptr_t end;
+  uint8_t* write;
+  uint32_t generation;  // Forks before the region was created.
+};
+
+std::mutex g_patch_mutex;
+pid_t g_patch_pid = 0;
+std::atomic<uint32_t> g_fork_generation{0};
+
+std::vector<PatchableRegion>& PatchableRegions() {
+  static auto* regions = NewForever<std::vector<PatchableRegion>>();
+  return *regions;
+}
+
+void MarkSharedLocked() {
+  uint32_t generation = g_fork_generation.fetch_add(1, std::memory_order_relaxed) + 1;
+  TRACE_AND_ALOGD("berberis: chain: fork, code generation %u", generation);
+}
+
+const PatchableRegion* FindRegionLocked(uintptr_t addr, size_t size) {
+  for (const auto& region : PatchableRegions()) {
+    if (region.begin <= addr && addr + size <= region.end) {
+      return &region;
+    }
+  }
+  return nullptr;
+}
+
+// Every fork, in both processes: what exists now is mapped by both. The mutex is held across the fork
+// so the child never inherits it locked.
+void LockForFork() {
+  g_patch_mutex.lock();
+}
+void MarkSharedAfterFork() {
+  MarkSharedLocked();
+  g_patch_pid = getpid();
+  g_patch_mutex.unlock();
+}
+
+}  // namespace
+
+void RegisterPatchableExecRegion(const uint8_t* exec, size_t size, uint8_t* write) {
+  static const bool kAtForkRegistered =
+      pthread_atfork(LockForFork, MarkSharedAfterFork, MarkSharedAfterFork) == 0;
+  (void)kAtForkRegistered;
+  std::lock_guard<std::mutex> lock(g_patch_mutex);
+  if (g_patch_pid == 0) {
+    g_patch_pid = getpid();
+  }
+  if (write == nullptr) {
+    return;
+  }
+  auto begin = bit_cast<uintptr_t>(exec);
+  PatchableRegions().push_back(
+      {begin, begin + size, write, g_fork_generation.load(std::memory_order_relaxed)});
+}
+
+void MarkPatchableExecRegionsShared() {
+  std::lock_guard<std::mutex> lock(g_patch_mutex);
+  MarkSharedLocked();
+}
+
+uint32_t PatchableExecRegionsGeneration() {
+  return g_fork_generation.load(std::memory_order_relaxed);
+}
+
+bool PatchChainSite(HostCodeAddr site, HostCodeAddr target) {
+  std::lock_guard<std::mutex> lock(g_patch_mutex);
+  // A fork that bypassed both pthread_atfork and the guest clone path.
+  if (pid_t pid = getpid(); pid != g_patch_pid) {
+    MarkSharedLocked();
+    g_patch_pid = pid;
+  }
+  const PatchableRegion* region = site % 4 == 0 ? FindRegionLocked(site, 4) : nullptr;
+  if (region == nullptr) {
+    return false;
+  }
+  int32_t disp = 0;
+  bool linked = false;
+  if (target != kNullHostCodeAddr) {
+    const PatchableRegion* target_region = FindRegionLocked(target, 1);
+    int64_t wide = int64_t{target} - int64_t{site} - 4;
+    if (target_region != nullptr && target_region->generation <= region->generation &&
+        wide >= INT32_MIN && wide <= INT32_MAX) {
+      disp = static_cast<int32_t>(wide);
+      linked = true;
+    }
+  }
+  __atomic_store_n(bit_cast<int32_t*>(region->write + (site - region->begin)), disp, __ATOMIC_RELEASE);
+  return target == kNullHostCodeAddr || linked;
+}
