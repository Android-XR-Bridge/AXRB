+// doesn't get.
+enum class LinkKind { kJump, kCall, kReturn };
+
+LinkKind GetLinkKind(GuestAddr pc) {
+  uint32_t insn = *ToHostAddr<const uint32_t>(pc);
+  if ((insn & 0xfc00'0000) == 0x9400'0000 || (insn & 0xffff'fc1f) == 0xd63f'0000) {
+    return LinkKind::kCall;  // BL, BLR
+  }
+  if ((insn & 0xffff'fc1f) == 0xd65f'0000) {
+    return LinkKind::kReturn;  // RET
+  }
+  return LinkKind::kJump;
+}
