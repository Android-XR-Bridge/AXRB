+
+// region digitalis
+// Host return prediction (see EmitDirectCallDispatch): guest calls push host call pairs that guest
+// returns take. These run long enough to gear up, so both tiers' calls and returns run.
+void RunToEnd(const uint32_t* code, size_t size) {
+  alignas(16) static uint64_t stack[8192];
+  GuestMapShadow::GetInstance()->SetExecutable(ToGuestAddr(code), size);
+  GuestThread* thread = GetCurrentGuestThread();
+  auto& cpu_state = thread->state()->cpu;
+  GuestAddr saved_sp = cpu_state.sp;
+  cpu_state.sp = ToGuestAddr(&stack[std::size(stack)]);
+  cpu_state.insn_addr = ToGuestAddr(code);
+  GuestAddr stop_pc = ToGuestAddr(code) + size;
+  auto cache = TranslationCache::GetInstance();
+  cache->SetStop(stop_pc);
+  ExecuteGuest(thread->state());
+  cache->TestingClearStop(stop_pc);
+  EXPECT_EQ(cpu_state.sp, ToGuestAddr(&stack[std::size(stack)]));
+  cpu_state.sp = saved_sp;
+  cache->InvalidateGuestRange(ToGuestAddr(code), stop_pc);
+  GuestMapShadow::GetInstance()->ClearExecutable(ToGuestAddr(code), size);
