+  as->Cmpq(as->rsp, limit);
+  as->Jcc(Assembler::Condition::kBelowEqual, *drop_pairs);
+  as->Bind(push);
+  as->Movq(as->rcx, return_pc);
+  as->Push(as->rcx);
