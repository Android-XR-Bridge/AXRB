+void EmitCallDispatch(x86_64::Assembler* as, GuestAddr return_pc, EmitCallee emit_callee) {
+  using Assembler = x86_64::Assembler;
+  const Assembler::Operand base = {
+      .base = Assembler::rbp,
+      .disp = static_cast<int32_t>(offsetof(ThreadState, host_return_stack.base))};
+  const Assembler::Operand limit = {
+      .base = Assembler::rbp,
+      .disp = static_cast<int32_t>(offsetof(ThreadState, host_return_stack.limit))};
+  Assembler::Label* push = as->MakeLabel();
+  Assembler::Label* callee = as->MakeLabel();
+  Assembler::Label* drop_pairs = as->MakeLabel();
