+GuestBranchKind GetArm64BranchKind(GuestAddr pc) {
+  uint32_t insn;
+  memcpy(&insn, ToHostAddr<const void>(pc), sizeof(insn));
+  if ((insn & 0xfc00'0000) == 0x9400'0000 || (insn & 0xffff'fc1f) == 0xd63f'0000) {
+    return GuestBranchKind::kCall;  // BL, BLR
+  }
+  if ((insn & 0xffff'fc1f) == 0xd65f'0000) {
+    return GuestBranchKind::kReturn;  // RET
+  }
+  return GuestBranchKind::kJump;
+}
+
+void EmitDirectCallDispatch(x86_64::Assembler* as, GuestAddr target, GuestAddr return_pc) {
+  if (!g_predict_returns || !config::kLinkJumpsBetweenRegions) {
+    EmitDirectDispatch(as, target, /*check_pending_signals=*/true);
+    return;
+  }
+  EmitCallDispatch(
+      as, return_pc, [&] { EmitDirectDispatch(as, target, /*check_pending_signals=*/true); });
+}
+
+void EmitIndirectCallDispatch(x86_64::Assembler* as,
+                              x86_64::Assembler::Register target,
+                              GuestAddr return_pc) {
+  if (!g_predict_returns || !config::kLinkJumpsBetweenRegions) {
+    EmitIndirectDispatch(as, target);
+    return;
+  }
+  // The pair is pushed with rcx: keep the target in rax, where the dispatch wants it anyway.
+  if (target != as->rax) {
+    as->Movq(as->rax, target);
+  }
+  EmitCallDispatch(as, return_pc, [&] { EmitIndirectDispatch(as, as->rax); });
+}
+
+void EmitReturnDispatch(x86_64::Assembler* as, x86_64::Assembler::Register target) {
+  if (!g_predict_returns || !config::kLinkJumpsBetweenRegions) {
+    EmitIndirectDispatch(as, target);
+    return;
+  }
+  using Assembler = x86_64::Assembler;
+  if (target != as->rax) {
+    as->Movq(as->rax, target);
+  }
+  Assembler::Label* miss = as->MakeLabel();
+  as->Cmpq(as->rax, {.base = Assembler::rsp, .disp = config::kHostReturnPairGuestOffset});
+  as->Jcc(Assembler::Condition::kNotEqual, *miss);
+  // The continuation checks pending signals.
+  as->Addq(as->rsp, int32_t{config::kHostReturnPairHostOffset});
+  as->Ret();
+
+  as->Bind(miss);
+  as->Movq(as->rsp,
+           {.base = Assembler::rbp,
+            .disp = static_cast<int32_t>(offsetof(ThreadState, host_return_stack.base))});
+  EmitIndirectDispatch(as, as->rax);
+}
