+// Host return prediction
+// ======================
+// A guest return is an indirect jump: its table lookup waits on a scattered table entry, and the
+// host predicts its target poorly (together ~10% of a Unity main thread). So a guest call also makes
+// a host call, which leaves a 32-byte pair on the host stack:
+//   [rsp + 24]  the guest return address (config::kHostReturnPairGuestOffset)
+//   [rsp + 16]  the host return address: a continuation in the caller, which pops the guest
+//               address and dispatches directly to it
+//   [rsp + 0]   16 free bytes, the callee's scratch (config::kFrameSizeAtTranslatedCode)
+// A guest return to the top pair's guest address takes it with a host ret, which the host predicts
+// through its return stack buffer. Any other return drops every pair (rsp back to the base frame of
+// berberis_RunGeneratedCode) and dispatches through the table.
+//
+// The pairs are only hints, so this stays right whatever the guest does with its stack (longjmp,
+// exceptions, calls that never return): a return only takes a pair holding the address it returns
+// to, and the continuation does what an ordinary dispatch to that address does. The base frame holds
+// a sentinel pair, whose host return exits generated code, so a return with no pairs is no special
+// case. Pairs may take config::kHostReturnStackSize bytes; a call past that drops them all first.
+bool g_predict_returns = true;
+
+template <typename EmitCallee>
+void EmitCallDispatch(x86_64::Assembler* as, GuestAddr return_pc, EmitCallee emit_callee) {
+  using Assembler = x86_64::Assembler;
+  const Assembler::Operand base = {
+      .base = Assembler::rbp,
+      .disp = static_cast<int32_t>(offsetof(ThreadState, host_return_stack.base))};
+  const Assembler::Operand limit = {
+      .base = Assembler::rbp,
+      .disp = static_cast<int32_t>(offsetof(ThreadState, host_return_stack.limit))};
+  Assembler::Label* push = as->MakeLabel();
+  Assembler::Label* callee = as->MakeLabel();
+  Assembler::Label* drop_pairs = as->MakeLabel();
+
+  as->Cmpq(as->rsp, limit);
+  as->Jcc(Assembler::Condition::kBelowEqual, *drop_pairs);
+  as->Bind(push);
+  as->Movq(as->rcx, return_pc);
+  as->Push(as->rcx);
+  as->Call(*callee);
+  // A guest return that took the pair lands here.
+  as->Addq(as->rsp, int32_t{8});
+  EmitDirectDispatch(as, return_pc, /*check_pending_signals=*/true);
+
+  as->Bind(callee);
+  as->Subq(as->rsp, int32_t{config::kHostReturnPairHostOffset});
+  emit_callee();
+
+  as->Bind(drop_pairs);
+  as->Movq(as->rsp, base);
+  as->Jmp(*push);
+}
