+// region digitalis
+// Host return prediction (see EmitDirectCallDispatch): guest calls push host call pairs that guest
+// returns take. These run long enough to gear up, so both tiers' calls and returns run.
+void RunToEnd(const uint32_t* code, size_t size) {
+  alignas(16) static uint64_t stack[8192];
+  GuestMapShadow::GetInstance()->SetExecutable(ToGuestAddr(code), size);
+  GuestThread* thread = GetCurrentGuestThread();
+  auto& cpu_state = thread->state()->cpu;
+  GuestAddr saved_sp = cpu_state.sp;
+  cpu_state.sp = ToGuestAddr(&stack[std::size(stack)]);
+  cpu_state.insn_addr = ToGuestAddr(code);
+  GuestAddr stop_pc = ToGuestAddr(code) + size;
+  auto cache = TranslationCache::GetInstance();
+  cache->SetStop(stop_pc);
+  ExecuteGuest(thread->state());
+  cache->TestingClearStop(stop_pc);
+  EXPECT_EQ(cpu_state.sp, ToGuestAddr(&stack[std::size(stack)]));
+  cpu_state.sp = saved_sp;
+  cache->InvalidateGuestRange(ToGuestAddr(code), stop_pc);
+  GuestMapShadow::GetInstance()->ClearExecutable(ToGuestAddr(code), size);
+}
+
+// Recursion 1000 deep, past what the pairs may take (config::kHostReturnStackSize), 20 times.
+TEST(Arm64ExecuteGuest, DeepRecursion) {
+  static const uint32_t code[] = {
+      0xd2800013,  //   mov x19, #0
+      0xd2800001,  //   mov x1, #0
+      0xd2807d00,  // outer: mov x0, #1000
+      0x94000005,  //   bl rec
+      0x91000673,  //   add x19, x19, #1
+      0xf100527f,  //   cmp x19, #20
+      0x54ffff81,  //   b.ne outer
+      0x14000008,  //   b end
+      0xb40000c0,  // rec: cbz x0, rec_ret
+      0xa9bf7bfd,  //   stp x29, x30, [sp, #-16]!
+      0xd1000400,  //   sub x0, x0, #1
+      0x97fffffd,  //   bl rec
+      0x91000421,  //   add x1, x1, #1
+      0xa8c17bfd,  //   ldp x29, x30, [sp], #16
+      0xd65f03c0,  // rec_ret: ret
+                   // end:
+  };
+  InitBerberis();
+  RunToEnd(code, sizeof(code));
+  auto& cpu_state = GetCurrentGuestThread()->state()->cpu;
+  EXPECT_EQ(cpu_state.x[1], 20'000u);
+  EXPECT_EQ(cpu_state.x[19], 20u);
+}
+
+// Calls that never return (each leaves a pair behind), a return to somewhere other than the return
+// address, and indirect calls.
+TEST(Arm64ExecuteGuest, UnpairedCallsAndReturns) {
+  static const uint32_t code[] = {
+      0xd2800013,  //   mov x19, #0
+      0xd2800001,  //   mov x1, #0
+      0x10000183,  //   adr x3, leaf
+      0x94000009,  // loop: bl escape
+      0x9400000a,  // back: bl leaf
+      0xd63f0060,  //   blr x3
+      0x9400000a,  //   bl skip
+      0x91019021,  //   add x1, x1, #100 (skipped)
+      0x91000673,  //   add x19, x19, #1
+      0xf11f427f,  //   cmp x19, #2000
+      0x54ffff21,  //   b.ne loop
+      0x14000007,  //   b end
+      0x10ffff02,  // escape: adr x2, back
+      0xd61f0040,  //   br x2
+      0x91000421,  // leaf: add x1, x1, #1
+      0xd65f03c0,  //   ret
+      0x910013de,  // skip: add x30, x30, #4
+      0xd65f03c0,  //   ret
+                   // end:
+  };
+  InitBerberis();
+  RunToEnd(code, sizeof(code));
+  auto& cpu_state = GetCurrentGuestThread()->state()->cpu;
