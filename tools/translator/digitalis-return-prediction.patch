+// region digitalis
+namespace {
+
+// Mirrors GetArm64BranchKind in code_gen_lib (return prediction), whose headers this library
+// doesn't get.
+enum class LinkKind { kJump, kCall, kReturn };
+
+LinkKind GetLinkKind(GuestAddr pc) {
+  uint32_t insn = *ToHostAddr<const uint32_t>(pc);
+  if ((insn & 0xfc00'0000) == 0x9400'0000 || (insn & 0xffff'fc1f) == 0xd63f'0000) {
+    return LinkKind::kCall;  // BL, BLR
+  }
+  if ((insn & 0xffff'fc1f) == 0xd65f'0000) {
+    return LinkKind::kReturn;  // RET
+  }
+  return LinkKind::kJump;
+}
+
+}  // namespace
+// endregion
+
 void HeavyOptimizerFrontend::ExitRegionIndirect(Register target) {
+  // region digitalis
+  switch (GetLinkKind(GetInsnAddr())) {
+    case LinkKind::kCall:
+      builder_.Gen<PseudoIndirectJump>(
+          target, PseudoIndirectJump::Kind::kCall, GetInsnAddr() + 4);
+      return;
+    case LinkKind::kReturn:
+      builder_.Gen<PseudoIndirectJump>(target, PseudoIndirectJump::Kind::kReturn);
+      return;
+    case LinkKind::kJump:
+      break;
+  }
+  // endregion
   builder_.Gen<PseudoIndirectJump>(target);
 }
 
+// region digitalis
+void HeavyOptimizerFrontend::GenCall(GuestAddr target) {
+  builder_.Gen<PseudoJump>(target, PseudoJump::Kind::kCall, GetInsnAddr() + 4);
+}
