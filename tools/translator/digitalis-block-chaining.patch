+      0xf13e801f,  // cmp x0, #4000
+      0x54ffffc1,  // b.ne loop
+      0x14000001,  // b .+4  (to stop_pc)
+  };
+
+  InitBerberis();
+
+  GuestMapShadow::GetInstance()->SetExecutable(ToGuestAddr(&code[0]), sizeof(code));
+
+  GuestThread* thread = GetCurrentGuestThread();
+  auto& cpu_state = thread->state()->cpu;
+  cpu_state.insn_addr = ToGuestAddr(&code[0]);
+  cpu_state.x[0] = 7;
+  GuestAddr stop_pc = ToGuestAddr(&code[0]) + sizeof(code);
+  auto cache = TranslationCache::GetInstance();
+  cache->SetStop(stop_pc);
+  ExecuteGuest(thread->state());
+  cache->TestingClearStop(stop_pc);
+  EXPECT_EQ(cpu_state.x[0], 4000u);
+
+  // The entry region's jump into the loop is linked to the loop's current code, which by now has
+  // geared up (it ran ~4000 times), so the link followed it from its lite code.
+  auto links_to = [&](GuestAddr from_pc, HostCodeAddr target) {
+    GuestCodeEntry* from = cache->LookupGuestCodeEntryUnsafeForTesting(from_pc);
+    if (!from) {
+      return false;
+    }
+    HostCodeAddr from_code = cache->GetHostCodePtr(from_pc)->load();
+    for (uint32_t i = 3; i + 5 <= from->host_size; i += 4) {
+      const auto* bytes = bit_cast<const uint8_t*>(uintptr_t{from_code + i});
+      int32_t disp;
+      memcpy(&disp, bytes + 1, 4);
+      if (bytes[0] == 0xe9 && int64_t{from_code} + i + 5 + disp == int64_t{target}) {
+        return true;
+      }
+    }
+    return false;
+  };
+  GuestAddr loop_pc = ToGuestAddr(&code[1]);
+  GuestCodeEntry* loop = cache->LookupGuestCodeEntryUnsafeForTesting(loop_pc);
+  ASSERT_TRUE(loop);
+  EXPECT_EQ(loop->kind, GuestCodeEntry::Kind::kHeavyOptimized);
+  EXPECT_TRUE(links_to(ToGuestAddr(&code[0]), cache->GetHostCodePtr(loop_pc)->load()));
+
+  // Run it again over the now fully linked code.
+  cpu_state.insn_addr = ToGuestAddr(&code[0]);
+  cache->SetStop(stop_pc);
+  ExecuteGuest(thread->state());
+  cache->TestingClearStop(stop_pc);
+  EXPECT_EQ(cpu_state.x[0], 4000u);
+
+  cache->InvalidateGuestRange(ToGuestAddr(&code[0]), stop_pc);
+  GuestMapShadow::GetInstance()->ClearExecutable(ToGuestAddr(&code[0]), sizeof(code));
+}
