+// region digitalis chain-sites
+// Block chaining (EmitDirectDispatch, TranslationCache::ChainSite): a chainable jump is linked once its
+// target is translated, follows the target to its new code on gear-up, and is unlinked when the target
+// is invalidated or ends up interpreted.
+TEST(Arm64ChainSites, LinkRelinkUnlink) {
+  constexpr GuestAddr kFrom = 0x10'0000;
+  constexpr GuestAddr kTo = 0x20'0000;
+  MachineCode jump;
+  x86_64::Assembler as(&jump);
+  as.ChainJmp32(kTo);
+  as.Finalize();
+  HostCodeAddr jump_code = GetDefaultCodePoolInstance()->Add(&jump);
+  std::vector<TranslationCache::ChainSite> sites;
+  jump.ForEachChainSite([&](uint32_t offset, intptr_t target) {
+    sites.push_back({jump_code + offset, static_cast<GuestAddr>(target)});
+  });
+  ASSERT_EQ(sites.size(), 1u);
+  EXPECT_EQ(sites[0].site % 4, 0u);
+  EXPECT_EQ(sites[0].target, kTo);
+  auto rel32 = [&] { return *bit_cast<const int32_t*>(uintptr_t{sites[0].site}); };
+  auto to = [&](HostCodeAddr code) {
+    return static_cast<int32_t>(int64_t{code} - int64_t{sites[0].site} - 4);
+  };
+
+  TranslationCache tc;
+  GuestCodeEntry* from = tc.AddAndLockForTranslation(kFrom, 0);
+  ASSERT_TRUE(from);
+  tc.SetTranslatedAndUnlock(kFrom,
+                            from,
+                            4,
+                            GuestCodeEntry::Kind::kLiteTranslated,
+                            {jump_code, jump.install_size()},
+                            &sites);
+  EXPECT_EQ(rel32(), 0);  // Target not translated: falls through to the table lookup.
+
+  MachineCode lite_code, heavy_code;
+  lite_code.AddU8(0xc3);
+  heavy_code.AddU8(0xc3);
+  HostCodeAddr lite = GetDefaultCodePoolInstance()->Add(&lite_code);
+  HostCodeAddr heavy = GetDefaultCodePoolInstance()->Add(&heavy_code);
+
+  GuestCodeEntry* target = tc.AddAndLockForTranslation(kTo, 0);
+  ASSERT_TRUE(target);
+  tc.SetTranslatedAndUnlock(kTo, target, 4, GuestCodeEntry::Kind::kLiteTranslated, {lite, 1});
+  EXPECT_EQ(rel32(), to(lite));
+
+  target = tc.LockForGearUpTranslation(kTo);
+  ASSERT_TRUE(target);
+  EXPECT_EQ(rel32(), to(lite));  // The lite code stays linked while the target gears up.
+  tc.SetTranslatedAndUnlock(kTo, target, 4, GuestCodeEntry::Kind::kHeavyOptimized, {heavy, 1});
+  EXPECT_EQ(rel32(), to(heavy));
+
+  tc.InvalidateGuestRange(kTo, kTo + 4);
+  EXPECT_EQ(rel32(), 0);
+
+  target = tc.AddAndLockForTranslation(kTo, 0);
+  ASSERT_TRUE(target);
+  tc.SetTranslatedAndUnlock(kTo, target, 4, GuestCodeEntry::Kind::kInterpreted, {kEntryInterpret, 0});
+  EXPECT_EQ(rel32(), 0);
+
+  // Invalidating while the target gears up unlinks its still-linked lite code.
+  tc.InvalidateGuestRange(kTo, kTo + 4);
+  target = tc.AddAndLockForTranslation(kTo, 0);
+  ASSERT_TRUE(target);
+  tc.SetTranslatedAndUnlock(kTo, target, 4, GuestCodeEntry::Kind::kLiteTranslated, {lite, 1});
+  EXPECT_EQ(rel32(), to(lite));
+  target = tc.LockForGearUpTranslation(kTo);
+  ASSERT_TRUE(target);
+  tc.InvalidateGuestRange(kTo, kTo + 4);
+  EXPECT_EQ(rel32(), 0);
+  tc.SetTranslatedAndUnlock(kTo, target, 4, GuestCodeEntry::Kind::kHeavyOptimized, {heavy, 1});
+  EXPECT_EQ(rel32(), 0);  // That translation was invalidated; it is dropped, not linked.
+}
+
+// After a fork, jumps only link to code at least as old as themselves (every process that maps the jump
+// maps that code); unlinking always works.
+TEST(Arm64ChainSites, LinksNeverReachNewerRegionsAfterFork) {
+  auto chain_jump = [](GuestAddr target, MachineCode* code) {
+    x86_64::Assembler as(code);
+    as.ChainJmp32(target);
+    as.Finalize();
+    HostCodeAddr installed = GetDefaultCodePoolInstance()->Add(code);
+    HostCodeAddr site = kNullHostCodeAddr;
+    code->ForEachChainSite([&](uint32_t offset, intptr_t) { site = installed + offset; });
+    return site;
+  };
+  auto rel32 = [](HostCodeAddr site) { return *bit_cast<const int32_t*>(uintptr_t{site}); };
+  auto ret = [] {
+    MachineCode code;
+    code.AddU8(0xc3);
+    return GetDefaultCodePoolInstance()->Add(&code);
+  };
+
+  MachineCode old_jump;
+  HostCodeAddr old_site = chain_jump(0x30'0000, &old_jump);
+  ASSERT_NE(old_site, kNullHostCodeAddr);
+  HostCodeAddr old_target = ret();
+  ASSERT_TRUE(PatchChainSite(old_site, old_target));
+  EXPECT_EQ(rel32(old_site), static_cast<int32_t>(int64_t{old_target} - int64_t{old_site} - 4));
+
+  MarkPatchableExecRegionsShared();  // A fork: CodePool::Add moves to a new region by itself.
+  HostCodeAddr new_target = ret();
+  MachineCode new_jump;
+  HostCodeAddr new_site = chain_jump(0x40'0000, &new_jump);
+
+  // Old jump -> new code: refused, and left unlinked.
+  EXPECT_FALSE(PatchChainSite(old_site, new_target));
+  EXPECT_EQ(rel32(old_site), 0);
+  // Old jump -> old code, and new jump -> old or new code: fine.
+  EXPECT_TRUE(PatchChainSite(old_site, old_target));
+  EXPECT_NE(rel32(old_site), 0);
+  EXPECT_TRUE(PatchChainSite(new_site, old_target));
+  EXPECT_TRUE(PatchChainSite(new_site, new_target));
+  // Unlinking always works.
+  EXPECT_TRUE(PatchChainSite(old_site, kNullHostCodeAddr));
+  EXPECT_EQ(rel32(old_site), 0);
+}
